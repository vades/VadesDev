<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Agents.AI" Version="1.24.0" />
      <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
      <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
      <PackageReference Include="OllamaSharp" Version="5.5.0" />
      <PackageReference Include="System.Numerics.Tensors" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Data\knowledge.md">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="appsettings.Local.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
